FarmSection:AddButton({
    Text = "Collect Coins Once",
    Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            calculateMapBounds()
            startAntiVoid()
            protectFall(char)
            while getUnvisitedCoinCount() > 0 do
                collectNearestCoin()
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local centerX = (mapBounds.minX + mapBounds.maxX) / 2
                local centerZ = (mapBounds.minZ + mapBounds.maxZ) / 2
                if centerX ~= -math.huge then
                    local hoverPos = safePosition(Vector3.new(centerX, hoverHeight, centerZ))
                    root.Anchored = false
                    moveToPosition(hoverPos, currentSpeed)
                    root.Anchored = true
                end
            end
            stopAntiVoid()
            Library:Notify({ Title = "Coins Collected", Lifetime = 2 })
        end
    end
})

