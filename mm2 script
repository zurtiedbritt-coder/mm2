-- ========================
-- COIN DETECTION
-- ========================
local function isVisited(coinPos)
    for _, pos in ipairs(visitedCoins) do
        if (pos - coinPos).Magnitude < 5 then return true end
    end
    return false
end

local function getNearestCoin(rootPos)
    local nearest = nil
    local shortestDist = math.huge
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" then
                if not isVisited(v.Position) then
                    local dist = (v.Position - rootPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = v
                    end
                end
            end
        end
    end
    return nearest
end

local function getCoinCount()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" and not isVisited(v.Position) then
                count = count + 1
            end
        end
    end
    return count
end

local function isBagFull()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") then
                local text = gui.Text:lower()
                local current, max = gui.Text:match("(%d+)%s*/%s*(%d+)")
                if current and max and tonumber(current) >= tonumber(max) then
                    if text:find("coin") or gui.Parent.Name:lower():find("coin") or gui.Parent.Parent.Name:lower():find("coin") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ========================
-- CHARACTER UTILITIES
-- ========================
local function forceReset()
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.Health = 0
        else
            char:BreakJoints()
        end
    end
end

local function waitForRespawn()
    local oldChar = LocalPlayer.Character
    if oldChar then
        while LocalPlayer.Character == oldChar and autofarmEnabled do task.wait(0.1) end
    end
    while not LocalPlayer.Character and autofarmEnabled do task.wait(0.1) end
    if LocalPlayer.Character then
        while not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and autofarmEnabled do task.wait(0.1) end
        task.wait(2)
    end
end

local function protectFall(char)
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function idleChar(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if root then
        root.Anchored = true
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.Velocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    if humanoid then
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function setAntiPlayer(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    if enabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCollisions[part] = part.CanCollide
                part.CanCollide = false
            end
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    else
        for part, wasCollidable in pairs(originalCollisions) do
            if part and part.Parent then
                part.CanCollide = wasCollidable
            end
        end
        originalCollisions = {}
    end
end

local antiPlayerConnection = nil
local function startAntiPlayerMonitor()
    if antiPlayerConnection then antiPlayerConnection:Disconnect() end
    antiPlayerConnection = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            if antiPlayerEnabled then
                task.wait(1)
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end)
end

local function stopAntiPlayerMonitor()
    if antiPlayerConnection then
        antiPlayerConnection:Disconnect()
        antiPlayerConnection = nil
    end
end

-- ========================
-- SAFE POSITION
-- ========================
local function safePosition(pos)
    if pos.Y < mapFloorY then
        return Vector3.new(pos.X, mapFloorY + 5, pos.Z)
    end
    return pos
end

-- ========================
-- MOVEMENT
-- ========================
local function moveToPosition(targetPos, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char:FindFirstChild("Humanoid")
    
    if humanoid then
        humanoid.AutoRotate = false
        humanoid.PlatformStand = false
    end
    rootPart.Anchored = false
    
    local startPos = rootPart.Position
    local safeTarget = safePosition(targetPos)
    local distance = (safeTarget - startPos).Magnitude
    if distance < 1 then return end
    
    local savedRotation = rootPart.CFrame - rootPart.Position
    local direction = (safeTarget - startPos).Unit
    local duration = distance / speed
    local startTime = os.clock()
    
    while true do
        if not autofarmEnabled then return end
        local charCheck = LocalPlayer.Character
        local rootCheck = charCheck and charCheck:FindFirstChild("HumanoidRootPart")
        if not rootCheck then return end
        
        local elapsed = os.clock() - startTime
        local alpha = math.min(elapsed / duration, 1)
        local newPos = startPos:Lerp(safeTarget, alpha)
        newPos = safePosition(newPos)
        
        rootCheck.CFrame = CFrame.new(newPos) * savedRotation
        rootCheck.AssemblyLinearVelocity = direction * speed
        rootCheck.Velocity = direction * speed
        
        if alpha >= 1 then break end
        RunService.Heartbeat:Wait()
    end
    
    if rootPart and rootPart.Parent then
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.Velocity = Vector3.new(0, 0, 0)
    end
    if humanoid then
        humanoid.AutoRotate = true
    end
end

-- ========================
-- COIN COLLECTION
-- ========================
local function collectNearestCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = char.HumanoidRootPart
    
    protectFall(char)
    
    local coin = getNearestCoin(rootPart.Position)
    if not coin then return end
    
    local isBottom = coin.Position.Y <= bottomThreshold
    local coinPos = safePosition(coin.CFrame.Position + Vector3.new(0, 3, 0))
    local airPos = Vector3.new(coinPos.X, hoverHeight, coinPos.Z)
    
    table.insert(visitedCoins, coin.Position)
    
    moveToPosition(coinPos, currentSpeed)
    task.wait(0.03)
    moveToPosition(airPos, currentSpeed)
    
    if isBottom then
        Library:Notify({ Title = "Grabbed bottom coin!", Lifetime = 1 })
    end
    
    local rootCheck = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if rootCheck then
        rootCheck.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootCheck.Velocity = Vector3.new(0, 0, 0)
        rootCheck.Anchored = true
    end
end

-- ========================
-- ANTI-VOID
-- ========================
local voidConnection = nil
local function startAntiVoid()
    if voidConnection then voidConnection:Disconnect() end
    voidConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            if rootPart.Anchored then return end
            local rootPos = rootPart.Position
            if rootPos.Y < mapFloorY then
                local savedRot = rootPart.CFrame - rootPart.Position
                rootPart.CFrame = CFrame.new(rootPos.X, mapFloorY + 15, rootPos.Z) * savedRot
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 100, 0)
                protectFall(char)
            end
        end
    end)
end

local function stopAntiVoid()
    if voidConnection then
        voidConnection:Disconnect()
        voidConnection = nil
    end
end

-- ========================
-- MAIN FARM LOOP
-- ========================
task.spawn(function()
    while true do
        if autofarmEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if isBagFull() then
                    Library:Notify({ Title = "Bag Full - Resetting", Lifetime = 3 })
                    visitedCoins = {}
                    forceReset()
                    task.wait(1)
                    waitForRespawn()
                    if autofarmEnabled then
                        visitedCoins = {}
                        Library:Notify({ Title = "New Round - Resuming", Lifetime = 2 })
                    end
                else
                    if getCoinCount() > 0 then
                        collectNearestCoin()
                    else
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local hoverPos = Vector3.new(root.Position.X, hoverHeight, root.Position.Z)
                            if math.abs(root.Position.Y - hoverHeight) > 5 then
                                root.Anchored = false
                                moveToPosition(hoverPos, currentSpeed)
                            end
                            root.Anchored = true
                        end
                        visitedCoins = {}
                        while autofarmEnabled and getCoinCount() == 0 do
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
        task.wait(0.02)
    end
end)

