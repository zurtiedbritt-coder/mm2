-- ========================
local function coinsExist()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" then
                return true
            end
        end
    end
    return false
end

local roundState = "IDLE"

task.spawn(function()
    while true do
        if autoRoundEnabled then
            if roundState == "IDLE" then
                if coinsExist() then
                    roundState = "WAITING_MAP"
                end
                
            elseif roundState == "WAITING_MAP" then
                local stable = 0
                while autoRoundEnabled and stable < 3 do
                    if coinsExist() then stable = stable + 1 else stable = 0 end
                    task.wait(1)
                end
                
                if autoRoundEnabled and coinsExist() then
                    calculateMapBounds()
                    Library:Notify({ Title = "Map loaded! Waiting 10s for timer...", Lifetime = 3 })
                    roundState = "WAITING_TIMER"
                else
                    roundState = "IDLE"
                end
                
            elseif roundState == "WAITING_TIMER" then
                -- FIXED: Do absolutely nothing to the character during this phase
                -- Let MM2 teleport you and freeze you naturally
                local timer = 0
                while autoRoundEnabled and timer < 10 do
                    if not coinsExist() then break end
                    task.wait(1)
                    timer = timer + 1
                end
                
                if autoRoundEnabled and coinsExist() then
                    inRound = true
                    autofarmEnabled = true
                    collectedCoins = 0
                    -- NOW we can start anti-void and protect fall
                    -- because the teleport/freeze is over
                    calculateMapBounds()
                    startAntiVoid()
                    local char = LocalPlayer.Character
                    if char then protectFall(char) end
                    if antiPlayerEnabled then setAntiPlayer(true) end
                    Library:Notify({ Title = "Auto-Farm Activated", Lifetime = 3 })
                    roundState = "FARMING"
                else
                    roundState = "IDLE"
                end
                
            elseif roundState == "FARMING" then
                if not coinsExist() then
                    roundState = "WAITING_END"
                end
                
            elseif roundState == "WAITING_END" then
                task.wait(3)
                if not coinsExist() then
                    inRound = false
                    autofarmEnabled = false
                    stopAntiVoid()
                    setAntiPlayer(false)
                    local char = LocalPlayer.Character
                    if char then releaseChar(char) end
                    visitedCoins = {}
                    collectedCoins = 0
                    Library:Notify({ Title = "Round Ended - Back to lobby", Lifetime = 3 })
                    roundState = "IDLE"
                else
                    roundState = "FARMING"
                end
            end
        else
            if roundState ~= "IDLE" then
                inRound = false
                autofarmEnabled = false
                stopAntiVoid()
                setAntiPlayer(false)
                local char = LocalPlayer.Character
                if char then releaseChar(char) end
                visitedCoins = {}
                collectedCoins = 0
                roundState = "IDLE"
            end
        end
        task.wait(0.5)
    end
end)

-- ========================
-- COIN DETECTION
-- ========================
local function isVisited(coinPos)
    for _, pos in ipairs(visitedCoins) do
        if (pos - coinPos).Magnitude < 5 then return true end
    end
    return false
end

local function cleanupVisited()
    local aliveCoins = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" then
                table.insert(aliveCoins, v.Position)
            end
        end
    end
    
    local cleaned = {}
    for _, visitedPos in ipairs(visitedCoins) do
        local stillExists = false
        for _, alivePos in ipairs(aliveCoins) do
            if (visitedPos - alivePos).Magnitude < 5 then
                stillExists = true
                break
            end
        end
        if stillExists then
            table.insert(cleaned, visitedPos)
        end
    end
    visitedCoins = cleaned
end

local function getNearestUnvisitedCoin(rootPos)
    local nearest = nil
    local shortestDist = math.huge
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" then
                if not isVisited(v.Position) then
                    local dist = (v.Position - rootPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = v
                    end
                end
            end
        end
    end
    return nearest
end

local function getUnvisitedCoinCount()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("coin") then
            if v.Parent and v.Parent.Name ~= "CoinBag" and not isVisited(v.Position) then
                count = count + 1
            end
        end
    end
    return count
end

-- ========================
-- ENHANCED MOVEMENT
-- ========================
local function moveToPosition(targetPos, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char:FindFirstChild("Humanoid")
    
    if humanoid then
        humanoid.AutoRotate = false
        humanoid.PlatformStand = false
    end
    rootPart.Anchored = false
    
    local startPos = rootPart.Position
    local safeTarget = safePosition(targetPos)
    local distance = (safeTarget - startPos).Magnitude
    if distance < 1 then return end
    
    local savedRotation = rootPart.CFrame - rootPart.Position
    local direction = (safeTarget - startPos).Unit
    local duration = distance / speed
    local startTime = os.clock()
    
    while true do
        if not autofarmEnabled then return end
        local charCheck = LocalPlayer.Character
        local rootCheck = charCheck and charCheck:FindFirstChild("HumanoidRootPart")
        if not rootCheck then return end
        
        local elapsed = os.clock() - startTime
        local alpha = math.min(elapsed / duration, 1)
        local easedAlpha = alpha * alpha * (3 - 2 * alpha)
        
        local newPos = startPos:Lerp(safeTarget, easedAlpha)
        newPos = safePosition(newPos)
        
        local actualDelta = newPos - rootCheck.Position
        local actualDist = actualDelta.Magnitude
        local frameVelocity = actualDist > 0.01 and actualDelta.Unit * speed or Vector3.new(0, 0, 0)
        
        rootCheck.CFrame = CFrame.new(newPos) * savedRotation
        rootCheck.AssemblyLinearVelocity = frameVelocity
        rootCheck.Velocity = frameVelocity
        
        if alpha >= 1 then break end
        RunService.Heartbeat:Wait()
    end
    
    if rootPart and rootPart.Parent then
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.Velocity = Vector3.new(0, 0, 0)
    end
    if humanoid then
        humanoid.AutoRotate = true
    end
end

-- ========================
-- COIN COLLECTION — VERIFIED
-- ========================
local function collectNearestCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = char.HumanoidRootPart
    
    protectFall(char)
    cleanupVisited()
    
    local coin = getNearestUnvisitedCoin(rootPart.Position)
    if not coin then return end
    
    local isBottom = coin.Position.Y <= bottomThreshold
    local coinPos = coin.CFrame.Position
    local grabPos = safePosition(coinPos + Vector3.new(0, 3, 0))
    local hoverPos = safePosition(Vector3.new(coinPos.X, hoverHeight, coinPos.Z))
    
    table.insert(visitedCoins, coin.Position)
    
    moveToPosition(grabPos, currentSpeed)
    task.wait(0.12)
    
    local wasCollected = false
    if not coin or not coin.Parent then
        wasCollected = true
    elseif coin.Parent.Name == "CoinBag" then
        wasCollected = true
    end
    
    if wasCollected then
        collectedCoins = collectedCoins + 1
        if isBottom then
            Library:Notify({ Title = "Grabbed bottom coin! (" .. collectedCoins .. "/" .. resetAtCoins .. ")", Lifetime = 1 })
        else
            Library:Notify({ Title = "Coin " .. collectedCoins .. "/" .. resetAtCoins, Lifetime = 1 })
        end
    else
        for i, pos in ipairs(visitedCoins) do
            if (pos - coinPos).Magnitude < 5 then
                table.remove(visitedCoins, i)
                break
            end
        end
    end
    
    moveToPosition(hoverPos, currentSpeed)
    
    local rootCheck = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if rootCheck then
        rootCheck.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootCheck.Velocity = Vector3.new(0, 0, 0)
        rootCheck.Anchored = true
    end
end

-- ========================
-- ANTI-VOID
-- ========================
local voidConnection = nil
local function startAntiVoid()
    if voidConnection then voidConnection:Disconnect() end
    voidConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            if rootPart.Anchored then return end
            local correctedPos = safePosition(rootPart.Position)
            if correctedPos ~= rootPart.Position then
                local savedRot = rootPart.CFrame - rootPart.Position
                rootPart.CFrame = CFrame.new(correctedPos) * savedRot
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 100, 0)
                protectFall(char)
            end
        end
    end)
end

local function stopAntiVoid()
    if voidConnection then
        voidConnection:Disconnect()
        voidConnection = nil
    end
end

-- ========================
-- MAIN FARM LOOP
-- ========================
task.spawn(function()
    while true do
        if autofarmEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if collectedCoins >= resetAtCoins then
                    Library:Notify({ Title = resetAtCoins .. " coins collected! Force resetting...", Lifetime = 3 })
                    visitedCoins = {}
                    collectedCoins = 0
                    forceReset()
                    task.wait(1)
                    waitForRespawn()
                    if autofarmEnabled then
                        visitedCoins = {}
                        calculateMapBounds()
                        Library:Notify({ Title = "Respawned - Resuming farm", Lifetime = 2 })
                    end
                else
                    local unvisitedCount = getUnvisitedCoinCount()
                    
                    if unvisitedCount > 0 then
                        collectNearestCoin()
                    else
                        if coinsExist() then
                            cleanupVisited()
                            if getUnvisitedCoinCount() > 0 then
                                collectNearestCoin()
                            else
                                local root = char:FindFirstChild("HumanoidRootPart")
                                if root then
                                    local centerX = (mapBounds.minX + mapBounds.maxX) / 2
                                    local centerZ = (mapBounds.minZ + mapBounds.maxZ) / 2
                                    if centerX ~= -math.huge then
                                        local hoverPos = safePosition(Vector3.new(centerX, hoverHeight, centerZ))
                                        if (root.Position - hoverPos).Magnitude > 10 then
                                            root.Anchored = false
                                            moveToPosition(hoverPos, currentSpeed)
                                        end
                                        root.Anchored = true
                                    end
                                end
                                while autofarmEnabled and getUnvisitedCoinCount() == 0 do
                                    cleanupVisited()
                                    task.wait(0.5)
                                end
                            end
                        else
                            visitedCoins = {}
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                local centerX = (mapBounds.minX + mapBounds.maxX) / 2
                                local centerZ = (mapBounds.minZ + mapBounds.maxZ) / 2
                                if centerX ~= -math.huge then
                                    local hoverPos = safePosition(Vector3.new(centerX, hoverHeight, centerZ))
                                    if (root.Position - hoverPos).Magnitude > 10 then
                                        root.Anchored = false
                                        moveToPosition(hoverPos, currentSpeed)
                                    end
                                    root.Anchored = true
                                end
                            end
                            while autofarmEnabled and getUnvisitedCoinCount() == 0 do
                                task.wait(0.5)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.02)
    end
end)

